{
  "id": "chrono",
  "name": "Chrono",
  "manifestVersion": 1,
  "version": "1.2.0",
  "description": "Flexible task timer with robust planning, drag & drop, and continuous persistence.",
  "author": "Custom",
  "icon": "icon.svg",
  "iFrame": true,
  "sidePanel": true,
  "type": "standard",
  "permissions": [
    "getTasks",
    "updateTask",
    "addTask",
    "showIndexHtmlAsView",
    "openDialog",
    "persistDataSynced",
    "loadSyncedData",
    "dispatchAction",
    "getAllProjects",
    "getAllTags"
  ]
}
